<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>班級社交測量系統 - 春日版</title>
  <!-- 載入 Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- 載入 FontAwesome 圖示庫 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    /* 確保 SVG 內的文字可以正確選取與顯示 */
    svg text {
      user-select: none;
    }
    .fade-in {
      animation: fadeIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    /* 自訂捲軸樣式 - 春日暖色 */
    .custom-scrollbar::-webkit-scrollbar { width: 8px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #fffbeb; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #fcd34d; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #fbbf24; }
  </style>
</head>
<body class="bg-amber-50/60 min-h-screen flex flex-col font-sans text-stone-700">

  <!-- 頂部導航列 (春日漸層綠) -->
  <header class="bg-gradient-to-r from-emerald-400 to-teal-500 text-white shadow-md z-10 sticky top-0">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        
        <!-- Logo 區 -->
        <div class="flex items-center space-x-3">
          <div class="bg-white/20 p-2 rounded-full backdrop-blur-sm">
            <i class="fa-solid fa-seedling h-6 w-6 text-white text-xl flex items-center justify-center"></i>
          </div>
          <h1 class="text-xl font-bold tracking-wider drop-shadow-sm">春日班級社交網 🌷</h1>
        </div>
        
        <!-- 導航列與身分切換 -->
        <div class="flex items-center space-x-6">
          <nav class="flex space-x-2" id="main-nav">
            <button onclick="changeTab('network')" id="nav-network" class="flex items-center space-x-2 px-4 py-2 rounded-full text-sm font-bold transition-all bg-white text-emerald-600 shadow-sm transform scale-105">
              <i class="fa-solid fa-chart-pie"></i>
              <span>關係網絡圖</span>
            </button>
            <button onclick="changeTab('dashboard')" id="nav-dashboard" class="flex items-center space-x-2 px-4 py-2 rounded-full text-sm font-medium transition-all text-emerald-50 hover:bg-white/20">
              <i class="fa-solid fa-table-columns"></i>
              <span>數據總覽</span>
            </button>
            <button onclick="changeTab('survey')" id="nav-survey" class="flex items-center space-x-2 px-4 py-2 rounded-full text-sm font-medium transition-all text-emerald-50 hover:bg-white/20">
              <i class="fa-solid fa-clipboard-question"></i>
              <span>學生問卷端</span>
            </button>
          </nav>
          
          <!-- 身分切換器 -->
          <div class="pl-6 border-l border-white/30 flex items-center space-x-2">
            <i class="fa-solid fa-user-circle text-white/80"></i>
            <select id="role-select" onchange="changeRole(this.value)" class="bg-emerald-600/50 text-white text-sm font-medium rounded-full px-3 py-1.5 border border-emerald-300/30 outline-none cursor-pointer hover:bg-emerald-600 transition-colors">
              <option value="teacher" class="text-slate-800 bg-white">👨‍🏫 教師模式</option>
              <option value="student" class="text-slate-800 bg-white">👦 學生模式</option>
            </select>
          </div>
        </div>

      </div>
    </div>
  </header>

  <!-- 主要內容區 -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 flex gap-6">
    
    <!-- 左側/主要內容 -->
    <div id="main-content" class="w-full transition-all duration-300">
      
      <!-- 關係網絡圖 Tab -->
      <div id="tab-network" class="fade-in bg-white/90 backdrop-blur-sm rounded-2xl shadow-sm border border-orange-100 p-6 h-full flex flex-col min-h-[650px]">
        <div class="flex justify-between items-center mb-4">
          <div>
            <h2 class="text-2xl font-bold text-emerald-800">班級社交網絡圖 🌿</h2>
            <p class="text-sm text-stone-500 mt-1">圓圈大小代表受關注度，線條代表同學們的互動指向。</p>
          </div>
          <div class="flex space-x-2 bg-amber-50 p-1.5 rounded-xl border border-amber-100">
            <button onclick="setFilter('all')" id="filter-all" class="px-4 py-1.5 text-sm rounded-lg transition bg-white shadow-sm font-bold text-emerald-700">全班關係</button>
            <button onclick="setFilter('friend')" id="filter-friend" class="px-4 py-1.5 text-sm rounded-lg transition text-stone-500 hover:text-stone-700">好朋友</button>
            <button onclick="setFilter('enemy')" id="filter-enemy" class="px-4 py-1.5 text-sm rounded-lg transition text-stone-500 hover:text-stone-700">需留意關係</button>
          </div>
        </div>
        <div class="flex-grow bg-gradient-to-br from-amber-50/50 to-orange-50/50 rounded-xl overflow-hidden relative border border-orange-100 flex items-center justify-center" id="svg-container">
          <!-- SVG 圖表將由 JS 動態生成於此 -->
        </div>
      </div>

      <!-- 數據總覽 Tab -->
      <div id="tab-dashboard" class="hidden fade-in bg-white/90 backdrop-blur-sm rounded-2xl shadow-sm border border-orange-100 overflow-hidden h-full flex flex-col">
        <div class="p-6 border-b border-orange-100 bg-amber-50/50 flex justify-between items-center">
          <div>
            <h2 class="text-2xl font-bold text-emerald-800">班級社交數據總覽 📊</h2>
            <p class="text-sm text-stone-500 mt-1">依據測量結果計算的個人社交指數與自動角色判定。</p>
          </div>
        </div>
        <div class="overflow-x-auto flex-grow custom-scrollbar">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-amber-100/50 text-emerald-800 text-sm border-b border-orange-100">
                <th class="p-4 font-bold">學生</th>
                <th class="p-4 font-bold text-center">社交指數</th>
                <th class="p-4 font-bold text-center text-emerald-600">獲得好友票</th>
                <th class="p-4 font-bold text-center text-rose-500">獲得敵意票</th>
                <th class="p-4 font-bold">系統判定角色</th>
                <th class="p-4 font-bold text-center">操作</th>
              </tr>
            </thead>
            <tbody id="dashboard-tbody" class="divide-y divide-orange-50">
              <!-- 表格內容將由 JS 動態生成 -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- 學生問卷端 Tab -->
      <div id="tab-survey" class="hidden fade-in bg-white rounded-2xl shadow-sm border border-orange-100 p-8 h-full max-w-3xl mx-auto mt-4">
        <div class="text-center mb-10">
          <div class="inline-block bg-amber-100 p-3 rounded-full mb-4">
            <i class="fa-solid fa-envelope-open-text text-3xl text-amber-600"></i>
          </div>
          <h2 class="text-3xl font-bold text-stone-800">班級人際小調查 ☀️</h2>
          <p id="survey-title-desc" class="text-stone-500 mt-3 font-medium">這是一個模擬學生填寫問卷的介面。老師可透過此問卷收集系統數據。</p>
        </div>

        <div class="mb-8 p-5 bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200 rounded-xl flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <span id="survey-user-label" class="text-amber-800 font-bold">目前模擬填寫身分：</span>
            <div id="survey-current-user" class="flex items-center space-x-2 bg-white px-4 py-2 rounded-lg border border-amber-200 shadow-sm">
              <!-- 目前身分 -->
            </div>
          </div>
          <select id="survey-user-select" onchange="changeSurveyUser(this.value)" class="border-amber-300 rounded-lg text-sm text-stone-700 focus:ring-amber-500 focus:border-amber-500 shadow-sm p-2.5 outline-none border bg-white font-medium hover:bg-amber-50">
            <!-- 選項 -->
          </select>
        </div>

        <!-- 多維度問卷題目區域 -->
        <div class="space-y-8">
          
          <!-- 分組場景 A：戶外活動 (校外教學) -->
          <div class="border-t-4 border-amber-400 pt-6">
            <span class="bg-amber-100 text-amber-800 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">情境一：戶外休閒與活動分組</span>
            
            <div class="bg-emerald-50/50 p-6 rounded-2xl border border-emerald-100 hover:shadow-md transition-shadow mt-4">
              <h3 class="text-lg font-bold text-emerald-800 mb-3 flex items-center">
                <span class="bg-emerald-200 text-emerald-700 w-8 h-8 rounded-full flex items-center justify-center mr-3 font-black">1-A</span>
                如果今天要去校外教學，你可以選 3 個人跟你同一組，你會優先選哪三位同學呢？
              </h3>
              <p class="text-sm text-emerald-600 mb-5 ml-11 font-medium">選出平時最常一起玩、最能放鬆相處的夥伴。🌱</p>
              <div id="survey-q1-options" class="ml-11 grid grid-cols-2 sm:grid-cols-3 gap-3">
                <!-- Q1 選項 -->
              </div>
            </div>

            <div class="bg-rose-50/50 p-6 rounded-2xl border border-rose-100 hover:shadow-md transition-shadow mt-4">
              <h3 class="text-lg font-bold text-rose-800 mb-3 flex items-center">
                <span class="bg-rose-200 text-rose-700 w-8 h-8 rounded-full flex items-center justify-center mr-3 font-black">1-B</span>
                如果今天要去校外教學，你不希望哪 3 個人跟你同一組？
              </h3>
              <p class="text-sm text-rose-600 mb-5 ml-11 font-medium">這個資料<span class="font-bold underline underline-offset-2">只有老師看得到</span>，請放心勾選。🤫</p>
              <div id="survey-q2-options" class="ml-11 grid grid-cols-2 sm:grid-cols-3 gap-3">
                <!-- Q2 選項 -->
              </div>
            </div>
          </div>

          <!-- 分組場景 B：課堂學習 (做報告與討論) -->
          <div class="border-t-4 border-teal-400 pt-6">
            <span class="bg-teal-100 text-teal-800 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">情境二：課堂學習與分組討論</span>
            
            <div class="bg-teal-50/40 p-6 rounded-2xl border border-teal-100 hover:shadow-md transition-shadow mt-4">
              <h3 class="text-lg font-bold text-teal-800 mb-3 flex items-center">
                <span class="bg-teal-200 text-teal-700 w-8 h-8 rounded-full flex items-center justify-center mr-3 font-black">2-A</span>
                如果課堂上要進行分組「主題報告與專題實作」，你最想和誰同一組？（最多選 3 位）
              </h3>
              <p class="text-sm text-teal-600 mb-5 ml-11 font-medium">選出你覺得做事認真、有默契、能一起把報告做好的學習夥伴。✍️</p>
              <div id="survey-q3-options" class="ml-11 grid grid-cols-2 sm:grid-cols-3 gap-3">
                <!-- Q3 選項 -->
              </div>
            </div>

            <div class="bg-orange-50/40 p-6 rounded-2xl border border-orange-100 hover:shadow-md transition-shadow mt-4">
              <h3 class="text-lg font-bold text-orange-800 mb-3 flex items-center">
                <span class="bg-orange-200 text-orange-700 w-8 h-8 rounded-full flex items-center justify-center mr-3 font-black">2-B</span>
                在做課堂報告時，你比較不希望和哪 3 位同學同一組？
              </h3>
              <p class="text-sm text-orange-600 mb-5 ml-11 font-medium">這能幫助老師協調學習小組，避免發生嚴重的課堂糾紛與負載不均。📄</p>
              <div id="survey-q4-options" class="ml-11 grid grid-cols-2 sm:grid-cols-3 gap-3">
                <!-- Q4 選項 -->
              </div>
            </div>
          </div>

          <!-- 情境 C：完全沒有往來與潛在破冰 -->
          <div class="border-t-4 border-indigo-400 pt-6">
            <span class="bg-indigo-100 text-indigo-800 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">情境三：日常往來與人際盲區</span>
            
            <div class="bg-indigo-50/40 p-6 rounded-2xl border border-indigo-100 hover:shadow-md transition-shadow mt-4">
              <h3 class="text-lg font-bold text-indigo-800 mb-3 flex items-center">
                <span class="bg-indigo-200 text-indigo-700 w-8 h-8 rounded-full flex items-center justify-center mr-3 font-black">3-A</span>
                在目前的班級生活中，你覺得哪些同學與你「最少講到話」或「幾乎沒有往來」？（可多選）
              </h3>
              <p class="text-sm text-indigo-600 mb-5 ml-11 font-medium">無論是座位很遠，還是純粹不熟，請選出平時極少互動的同學。💤</p>
              <div id="survey-q5-options" class="ml-11 grid grid-cols-2 sm:grid-cols-3 gap-3">
                <!-- Q5 選項 -->
              </div>
            </div>

            <div class="bg-amber-50/50 p-6 rounded-2xl border border-amber-100 hover:shadow-md transition-shadow mt-4">
              <h3 class="text-lg font-bold text-amber-900 mb-3 flex items-center">
                <span class="bg-amber-200 text-amber-700 w-8 h-8 rounded-full flex items-center justify-center mr-3 font-black">3-B</span>
                承上題，如果未來有機會（例如換座位、重新分組），你最想和誰多聊天或多認識？（最多選 2 位）
              </h3>
              <p class="text-sm text-amber-700 mb-5 ml-11 font-medium">寫下你想打破隔閡、有興趣主動去認識的同學吧！🌱</p>
              <div id="survey-q6-options" class="ml-11 grid grid-cols-2 sm:grid-cols-3 gap-3">
                <!-- Q6 選項 -->
              </div>
            </div>
          </div>

          <div class="flex justify-center pt-8 border-t border-dashed border-stone-200">
            <button onclick="alert('🌸 問卷已成功送出！謝謝你提供寶貴的班級建議，祝你有個美好的一天！')" class="bg-gradient-to-r from-amber-400 to-orange-500 text-white px-10 py-4 rounded-full font-bold text-lg shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all flex items-center">
              <i class="fa-solid fa-paper-plane mr-3"></i>
              確認送出所有問卷資料
            </button>
          </div>
        </div>
      </div>

    </div>

    <!-- 右側：個人詳細資料面板 (隱藏/顯示) -->
    <div id="sidebar" class="hidden w-1/3 min-w-[320px] bg-white rounded-2xl shadow-xl border border-orange-100 overflow-hidden flex-col h-[calc(100vh-8rem)] sticky top-24">
      <!-- 側邊欄內容由 JS 動態生成 -->
    </div>

  </main>

  <script>
    // --- Mock Data (模擬資料) ---
    const INITIAL_STUDENTS = [
      { id: 's1', name: '小明', gender: 'M', avatar: '👦' },
      { id: 's2', name: '小美', gender: 'F', avatar: '👧' },
      { id: 's3', name: '阿強', gender: 'M', avatar: '👦🏽' },
      { id: 's4', name: '小華', gender: 'M', avatar: '👦🏻' },
      { id: 's5', name: '安安', gender: 'F', avatar: '👧🏻' },
      { id: 's6', name: '大雄', gender: 'M', avatar: '👦🏼' },
      { id: 's7', name: '靜香', gender: 'F', avatar: '👧🏼' },
      { id: 's8', name: '胖虎', gender: 'M', avatar: '👦🏾' },
      { id: 's9', name: '小夫', gender: 'M', avatar: '👦' },
      { id: 's10', name: '小草', gender: 'F', avatar: '👧🏽' },
    ];

    const INITIAL_RELATIONSHIPS = [
      { source: 's2', target: 's1', type: 'friend' }, { source: 's4', target: 's1', type: 'friend' },
      { source: 's5', target: 's1', type: 'friend' }, { source: 's6', target: 's1', type: 'friend' },
      { source: 's7', target: 's1', type: 'friend' }, { source: 's1', target: 's6', type: 'friend' },
      { source: 's1', target: 's7', type: 'friend' }, { source: 's8', target: 's6', type: 'enemy' },
      { source: 's8', target: 's9', type: 'friend' }, { source: 's9', target: 's8', type: 'friend' },
      { source: 's3', target: 's8', type: 'enemy' },  { source: 's6', target: 's8', type: 'enemy' },
      { source: 's4', target: 's8', type: 'enemy' },  { source: 's3', target: 's4', type: 'enemy' },
      { source: 's4', target: 's3', type: 'enemy' },  { source: 's2', target: 's7', type: 'friend' },
      { source: 's7', target: 's2', type: 'friend' }, { source: 's5', target: 's2', type: 'friend' },
      { source: 's9', target: 's1', type: 'enemy' }
    ];

    // --- State (狀態管理) ---
    let currentRole = 'teacher'; // teacher or student
    let activeTab = 'network';
    let selectedStudentId = null;
    let filterType = 'all';
    let surveyActingAs = INITIAL_STUDENTS[0].id;
    let studentStats = {};
    let studentsArray = [];

    // --- 初始化與數據計算 ---
    function init() {
      calculateStats();
      renderAll();
    }

    function calculateStats() {
      studentStats = {};
      INITIAL_STUDENTS.forEach(s => {
        studentStats[s.id] = {
          ...s,
          incomingFriends: 0, incomingEnemies: 0,
          outgoingFriends: 0, outgoingEnemies: 0,
          friendsList: [], enemiesList: [], noContactList: []
        };
      });

      INITIAL_RELATIONSHIPS.forEach(r => {
        if (studentStats[r.target] && studentStats[r.source]) {
          if (r.type === 'friend') {
            studentStats[r.target].incomingFriends++;
            studentStats[r.source].outgoingFriends++;
            studentStats[r.target].friendsList.push(r.source);
          } else if (r.type === 'enemy') {
            studentStats[r.target].incomingEnemies++;
            studentStats[r.source].outgoingEnemies++;
            studentStats[r.target].enemiesList.push(r.source);
          }
        }
      });

      Object.values(studentStats).forEach(s => {
        s.socialIndex = s.incomingFriends - s.incomingEnemies;
        
        const interactedIds = new Set([...s.friendsList, ...s.enemiesList, 
          ...INITIAL_RELATIONSHIPS.filter(r => r.source === s.id).map(r => r.target)]);
        s.noContactList = INITIAL_STUDENTS.filter(st => st.id !== s.id && !interactedIds.has(st.id)).map(st => st.id);

        if (s.incomingFriends >= 4 && s.incomingEnemies <= 1) s.role = '人氣王';
        else if (s.incomingEnemies >= 3) s.role = '被排斥';
        else if (s.incomingFriends === 0 && s.incomingEnemies === 0) s.role = '邊緣人';
        else if (s.incomingFriends >= 2 && s.incomingEnemies >= 2) s.role = '爭議人物';
        else s.role = '一般學生';
      });

      studentsArray = Object.values(studentStats).sort((a, b) => b.socialIndex - a.socialIndex);
    }

    // --- 角色切換邏輯 ---
    function changeRole(role) {
      currentRole = role;
      const navNetwork = document.getElementById('nav-network');
      const navDashboard = document.getElementById('nav-dashboard');
      const surveyTitleDesc = document.getElementById('survey-title-desc');
      const surveyUserLabel = document.getElementById('survey-user-label');

      if (role === 'student') {
        // 學生模式：隱藏圖表與數據導航
        navNetwork.style.display = 'none';
        navDashboard.style.display = 'none';
        surveyTitleDesc.innerHTML = '請根據你真實的想法填寫，你的答案<span class="text-rose-500 font-bold">只有老師會看到</span>喔！🌱';
        surveyUserLabel.innerText = '我是：';
        selectedStudentId = null; // 關閉側邊欄
        changeTab('survey');      // 強制跳轉到問卷頁面
      } else {
        // 老師模式：顯示所有導航
        navNetwork.style.display = 'flex';
        navDashboard.style.display = 'flex';
        surveyTitleDesc.innerText = '這是一個模擬學生填寫問卷的介面。老師可透過此問卷收集系統數據。';
        surveyUserLabel.innerText = '目前模擬填寫身分：';
        changeTab('network');     // 預設跳轉回網絡圖
      }
    }

    // --- 渲染畫面 ---
    function renderAll() {
      updateTabVisibility();
      if (activeTab === 'network' && currentRole === 'teacher') renderNetworkGraph();
      if (activeTab === 'dashboard' && currentRole === 'teacher') renderDashboard();
      if (activeTab === 'survey') renderSurvey();
      renderSidebar();
    }

    // 處理頁籤切換
    function changeTab(tab) {
      // 安全機制：如果是學生，不允許切換到圖表頁
      if (currentRole === 'student' && tab !== 'survey') {
        tab = 'survey';
      }
      activeTab = tab;
      
      // 更新導航列樣式 (春日風)
      const tabs = ['network', 'dashboard', 'survey'];
      tabs.forEach(t => {
        const btn = document.getElementById(`nav-${t}`);
        if(!btn) return;
        if (t === activeTab) {
          btn.className = `flex items-center space-x-2 px-4 py-2 rounded-full text-sm font-bold transition-all bg-white text-emerald-600 shadow-md transform scale-105`;
        } else {
          btn.className = `flex items-center space-x-2 px-4 py-2 rounded-full text-sm font-medium transition-all text-emerald-50 hover:bg-white/20`;
        }
      });

      renderAll();
    }

    function updateTabVisibility() {
      document.getElementById('tab-network').style.display = activeTab === 'network' ? 'flex' : 'none';
      document.getElementById('tab-dashboard').style.display = activeTab === 'dashboard' ? 'flex' : 'none';
      document.getElementById('tab-survey').style.display = activeTab === 'survey' ? 'block' : 'none';
    }

    // 處理過濾器切換
    function setFilter(type) {
      filterType = type;
      
      const filters = ['all', 'friend', 'enemy'];
      filters.forEach(f => {
        const btn = document.getElementById(`filter-${f}`);
        if (f === type) {
          if (f === 'all') btn.className = 'px-4 py-1.5 text-sm rounded-lg transition bg-white shadow-sm font-bold text-emerald-700';
          if (f === 'friend') btn.className = 'px-4 py-1.5 text-sm rounded-lg transition bg-emerald-100 shadow-sm font-bold text-emerald-700';
          if (f === 'enemy') btn.className = 'px-4 py-1.5 text-sm rounded-lg transition bg-rose-100 shadow-sm font-bold text-rose-700';
        } else {
          btn.className = 'px-4 py-1.5 text-sm rounded-lg transition text-stone-500 hover:text-stone-700 hover:bg-amber-100/50';
        }
      });
      
      renderNetworkGraph();
    }

    // 選擇學生
    function selectStudent(id) {
      if(currentRole === 'student') return; // 學生模式不允許點擊右側欄
      selectedStudentId = selectedStudentId === id ? null : id;
      renderNetworkGraph();
      renderSidebar();
    }

    // --- 生成關係網絡圖 (SVG) ---
    function renderNetworkGraph() {
      const container = document.getElementById('svg-container');
      const width = 800, height = 600, radius = 220;
      const centerX = width / 2, centerY = height / 2 + 20;

      const nodes = INITIAL_STUDENTS.map((student, index) => {
        const angle = (index / INITIAL_STUDENTS.length) * 2 * Math.PI - Math.PI / 2;
        return { ...student, x: centerX + radius * Math.cos(angle), y: centerY + radius * Math.sin(angle) };
      });

      let rels = INITIAL_RELATIONSHIPS;
      if (filterType !== 'all') rels = rels.filter(r => r.type === filterType);
      if (selectedStudentId) rels = rels.filter(r => r.source === selectedStudentId || r.target === selectedStudentId);

      const edges = rels.map(rel => {
        return { ...rel, sourceNode: nodes.find(n => n.id === rel.source), targetNode: nodes.find(n => n.id === rel.target) };
      }).filter(e => e.sourceNode && e.targetNode);

      let svgHTML = `
        <svg viewBox="0 0 ${width} ${height}" class="w-full h-full max-h-[600px] drop-shadow-sm">
          <defs>
            <marker id="arrow-friend" viewBox="0 -5 10 10" refX="28" refY="0" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M0,-5L10,0L0,5" fill="#10b981" opacity="0.8" />
            </marker>
            <marker id="arrow-enemy" viewBox="0 -5 10 10" refX="28" refY="0" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M0,-5L10,0L0,5" fill="#f43f5e" opacity="0.8" />
            </marker>
          </defs>
      `;

      edges.forEach(edge => {
        const isFriend = edge.type === 'friend';
        const isHighlighted = selectedStudentId === edge.source || selectedStudentId === edge.target;
        const opacity = selectedStudentId ? (isHighlighted ? 1 : 0.1) : 0.6;
        
        const dx = edge.targetNode.x - edge.sourceNode.x;
        const dy = edge.targetNode.y - edge.sourceNode.y;
        const dr = Math.sqrt(dx * dx + dy * dy) * 1.5; 
        
        const isBidirectional = INITIAL_RELATIONSHIPS.some(r => r.source === edge.target && r.target === edge.source && r.type === edge.type);
        const pathData = isBidirectional 
          ? `M${edge.sourceNode.x},${edge.sourceNode.y} A${dr},${dr} 0 0,1 ${edge.targetNode.x},${edge.targetNode.y}`
          : `M${edge.sourceNode.x},${edge.sourceNode.y} L${edge.targetNode.x},${edge.targetNode.y}`;

        svgHTML += `
          <path d="${pathData}" fill="none" 
            stroke="${isFriend ? '#10b981' : '#f43f5e'}" 
            stroke-width="${isHighlighted ? 3 : 2}" 
            stroke-dasharray="${isFriend ? 'none' : '5,5'}" 
            opacity="${opacity}" 
            marker-end="url(#arrow-${edge.type})" 
            class="transition-all duration-300" />
        `;
      });

      nodes.forEach(node => {
        const isSelected = selectedStudentId === node.id;
        const isDimmed = selectedStudentId && !isSelected && 
                         !edges.some(e => (e.source === selectedStudentId && e.target === node.id) || (e.target === selectedStudentId && e.source === node.id));
        
        const stats = studentStats[node.id];
        const mentions = stats.incomingFriends + stats.incomingEnemies;
        const nodeRadius = 20 + Math.min(mentions * 2, 15);
        
        const opacityClass = isDimmed ? 'opacity-30' : 'opacity-100 hover:scale-110';
        const strokeColor = isSelected ? '#f59e0b' : '#fde68a'; // 春日橙黃 / 淺黃邊框
        const strokeWidth = isSelected ? 4 : 3;
        const nameColor = isSelected ? 'fill-amber-700' : 'fill-stone-600';
        const badgeColor = stats.socialIndex >= 0 ? '#10b981' : '#f43f5e';
        const sign = stats.socialIndex > 0 ? '+' : '';

        svgHTML += `
          <g transform="translate(${node.x}, ${node.y})" onclick="selectStudent('${node.id}')" style="cursor: pointer;" class="transition-all duration-300 ${opacityClass} origin-center">
            <circle r="${nodeRadius}" fill="white" stroke="${strokeColor}" stroke-width="${strokeWidth}" class="shadow-lg" />
            <text text-anchor="middle" dy=".3em" font-size="24">${node.avatar}</text>
            <text text-anchor="middle" dy="${nodeRadius + 18}" font-size="13" font-weight="bold" class="${nameColor}">${node.name}</text>
            <rect x="${nodeRadius - 10}" y="${-nodeRadius - 12}" width="22" height="22" rx="11" fill="${badgeColor}" stroke="white" stroke-width="2" />
            <text x="${nodeRadius + 1}" y="${-nodeRadius + 3}" text-anchor="middle" font-size="11" fill="white" font-weight="bold">${sign}${stats.socialIndex}</text>
          </g>
        `;
      });

      svgHTML += `
        </svg>
        <div class="absolute bottom-4 left-4 bg-white/90 p-4 rounded-xl border border-orange-100 shadow-sm text-xs space-y-3 backdrop-blur-sm pointer-events-none">
          <div class="flex items-center space-x-3">
            <div class="w-6 h-0.5 bg-emerald-500 rounded-full"></div><span class="text-stone-600 font-medium">好朋友 (想同組)</span>
          </div>
          <div class="flex items-center space-x-3">
            <div class="w-6 h-0.5 bg-rose-500 border-t-2 border-dashed border-rose-500"></div><span class="text-stone-600 font-medium">敵意 (不想同組)</span>
          </div>
          <div class="flex items-center space-x-3 mt-2 pt-2 border-t border-orange-100">
            <div class="w-5 h-5 rounded-full bg-emerald-500 flex items-center justify-center text-[10px] text-white font-bold">+</div>
            <span class="text-stone-600 font-medium">正向社交指數</span>
          </div>
        </div>
      `;
      container.innerHTML = svgHTML;
    }

    // --- 生成數據總覽 (Dashboard) ---
    function renderDashboard() {
      const tbody = document.getElementById('dashboard-tbody');
      let html = '';

      const getRoleBadge = (role) => {
        switch (role) {
          case '人氣王': return '<span class="px-3 py-1 text-xs font-bold rounded-full bg-amber-100 text-amber-700 border border-amber-200">✨ 人氣王</span>';
          case '被排斥': return '<span class="px-3 py-1 text-xs font-bold rounded-full bg-rose-100 text-rose-700 border border-rose-200">💔 被排斥</span>';
          case '邊緣人': return '<span class="px-3 py-1 text-xs font-bold rounded-full bg-stone-100 text-stone-600 border border-stone-200">🌫️ 邊緣人</span>';
          case '爭議人物': return '<span class="px-3 py-1 text-xs font-bold rounded-full bg-orange-100 text-orange-700 border border-orange-200">🔥 爭議人物</span>';
          default: return '<span class="px-3 py-1 text-xs font-bold rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">一般學生</span>';
        }
      };

      studentsArray.forEach(student => {
        const sign = student.socialIndex > 0 ? '+' : '';
        const indexClass = student.socialIndex > 0 ? 'bg-emerald-100 text-emerald-700' : student.socialIndex < 0 ? 'bg-rose-100 text-rose-700' : 'bg-stone-100 text-stone-700';
        
        html += `
          <tr class="hover:bg-white transition-colors">
            <td class="p-4 flex items-center space-x-3">
              <span class="text-2xl">${student.avatar}</span>
              <span class="font-bold text-stone-700">${student.name}</span>
            </td>
            <td class="p-4 text-center">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-full font-bold text-sm ${indexClass} shadow-sm">
                ${sign}${student.socialIndex}
              </span>
            </td>
            <td class="p-4 text-center font-bold text-emerald-600">${student.incomingFriends}</td>
            <td class="p-4 text-center font-bold text-rose-500">${student.incomingEnemies}</td>
            <td class="p-4">
              ${getRoleBadge(student.role)}
            </td>
            <td class="p-4 text-center">
              <button onclick="selectStudent('${student.id}')" class="text-emerald-600 hover:text-emerald-800 text-sm font-bold hover:underline bg-emerald-50 px-3 py-1 rounded-lg">查看詳情</button>
            </td>
          </tr>
        `;
      });
      tbody.innerHTML = html;
    }

    // --- 生成多維度問卷模擬 (Survey) ---
    function renderSurvey() {
      const currentUser = INITIAL_STUDENTS.find(s => s.id === surveyActingAs);
      const otherStudents = INITIAL_STUDENTS.filter(s => s.id !== surveyActingAs);

      // 當前填答學生卡片
      document.getElementById('survey-current-user').innerHTML = `
        <span class="text-xl">${currentUser.avatar}</span>
        <span class="font-bold text-amber-700">${currentUser.name}</span>
      `;

      // 下拉選單選取器
      const select = document.getElementById('survey-user-select');
      select.innerHTML = INITIAL_STUDENTS.map(s => 
        `<option value="${s.id}" ${s.id === surveyActingAs ? 'selected' : ''}>${s.name}</option>`
      ).join('');

      // 動態更新 6 個問題的選項，確保各題選項具有獨立的 checkbox ID 與 name
      const qContainers = [
        { id: 'survey-q1-options', theme: 'emerald', focus: 'emerald' }, // Q1-A 校外教學正向
        { id: 'survey-q2-options', theme: 'rose', focus: 'rose' },       // Q1-B 校外教學負向
        { id: 'survey-q3-options', theme: 'teal', focus: 'teal' },       // Q2-A 報告正向
        { id: 'survey-q4-options', theme: 'orange', focus: 'orange' },   // Q2-B 報告負向
        { id: 'survey-q5-options', theme: 'indigo', focus: 'indigo' },   // Q3-A 零往來
        { id: 'survey-q6-options', theme: 'amber', focus: 'amber' }      // Q3-B 未來盼望
      ];

      qContainers.forEach((q, index) => {
        const container = document.getElementById(q.id);
        let html = '';
        
        otherStudents.forEach(s => {
          let checkStyle = '';
          if (q.theme === 'emerald') checkStyle = 'text-emerald-500 border-emerald-300 focus:ring-emerald-500';
          if (q.theme === 'rose') checkStyle = 'text-rose-500 border-rose-300 focus:ring-rose-500';
          if (q.theme === 'teal') checkStyle = 'text-teal-500 border-teal-300 focus:ring-teal-500';
          if (q.theme === 'orange') checkStyle = 'text-orange-500 border-orange-300 focus:ring-orange-500';
          if (q.theme === 'indigo') checkStyle = 'text-indigo-500 border-indigo-300 focus:ring-indigo-500';
          if (q.theme === 'amber') checkStyle = 'text-amber-500 border-amber-300 focus:ring-amber-500';

          let hoverBorder = `hover:bg-${q.theme}-50 hover:border-${q.theme}-300`;
          let baseBorder = `border-${q.theme}-100`;
          
          html += `
            <label class="flex items-center space-x-3 p-3 bg-white border ${baseBorder} rounded-xl cursor-pointer ${hoverBorder} transition-all shadow-sm">
              <input type="checkbox" name="q${index+1}_options" value="${s.id}" class="form-checkbox h-5 w-5 rounded ${checkStyle}" />
              <span class="flex items-center space-x-2">
                <span>${s.avatar}</span>
                <span class="font-bold text-stone-700">${s.name}</span>
              </span>
            </label>
          `;
        });
        container.innerHTML = html;
      });
    }

    function changeSurveyUser(id) {
      surveyActingAs = id;
      renderSurvey();
    }

    // --- 生成右側詳細資料面板 (Sidebar) ---
    function renderSidebar() {
      const sidebar = document.getElementById('sidebar');
      const mainContent = document.getElementById('main-content');

      if (!selectedStudentId || currentRole === 'student') {
        sidebar.classList.add('hidden');
        sidebar.classList.remove('flex');
        mainContent.className = 'w-full transition-all duration-300';
        return;
      }

      const student = studentStats[selectedStudentId];
      sidebar.classList.remove('hidden');
      sidebar.classList.add('flex');
      mainContent.className = 'w-2/3 transition-all duration-300';

      const renderList = (ids, emptyMsg, typeClass) => {
        if (ids.length === 0) return `<p class="text-sm text-stone-400 italic py-2">${emptyMsg}</p>`;
        return `<div class="flex flex-wrap gap-2 mt-2">` + ids.map(id => `
          <button onclick="selectStudent('${id}')" class="flex items-center space-x-1 px-3 py-1.5 rounded-lg text-sm transition-transform hover:scale-105 shadow-sm font-bold ${typeClass}">
            <span>${studentStats[id].avatar}</span><span>${studentStats[id].name}</span>
          </button>
        `).join('') + `</div>`;
      };

      const sign = student.socialIndex > 0 ? '+' : '';
      const indexColor = student.socialIndex >= 0 ? 'text-emerald-600' : 'text-rose-600';

      sidebar.innerHTML = `
        <div class="bg-gradient-to-br from-amber-400 to-orange-500 p-6 text-white relative flex-shrink-0">
          <button onclick="selectStudent(null)" class="absolute top-4 right-4 text-white/80 hover:text-white bg-black/10 hover:bg-black/20 w-8 h-8 rounded-full flex items-center justify-center transition-colors">
            <i class="fa-solid fa-xmark text-lg"></i>
          </button>
          <div class="flex flex-col items-center">
            <div class="text-6xl mb-3 bg-white/20 w-24 h-24 flex items-center justify-center rounded-full border-4 border-white/40 shadow-inner">${student.avatar}</div>
            <h2 class="text-3xl font-bold drop-shadow-sm">${student.name}</h2>
            <div class="mt-3 bg-white/20 px-4 py-1.5 rounded-full text-sm font-bold shadow-sm">
              系統判定：${student.role}
            </div>
          </div>
        </div>
        <div class="flex-grow overflow-y-auto p-6 space-y-6 bg-orange-50/30 custom-scrollbar">
          <div class="grid grid-cols-3 gap-3">
            <div class="bg-white p-3 rounded-xl border border-orange-100 text-center shadow-sm">
              <div class="text-xs text-stone-500 mb-1 font-medium">社交指數</div>
              <div class="text-2xl font-black ${indexColor}">${sign}${student.socialIndex}</div>
            </div>
            <div class="bg-emerald-50/50 p-3 rounded-xl border border-emerald-100 text-center shadow-sm">
              <div class="text-xs text-emerald-600 mb-1 font-medium">獲得好友</div>
              <div class="text-2xl font-black text-emerald-600">${student.incomingFriends}</div>
            </div>
            <div class="bg-rose-50/50 p-3 rounded-xl border border-rose-100 text-center shadow-sm">
              <div class="text-xs text-rose-600 mb-1 font-medium">獲得敵意</div>
              <div class="text-2xl font-black text-rose-500">${student.incomingEnemies}</div>
            </div>
          </div>
          
          <div class="space-y-4">
            <div class="bg-white p-5 rounded-xl border border-orange-100 shadow-sm relative overflow-hidden">
              <div class="absolute top-0 left-0 w-1 h-full bg-emerald-400"></div>
              <h3 class="flex items-center text-sm font-bold text-stone-700 border-b border-stone-100 pb-2 mb-3">
                <i class="fa-solid fa-user-plus mr-2 text-emerald-500"></i>誰當 ${student.name} 是好朋友？ (${student.friendsList.length})
              </h3>
              ${renderList(student.friendsList, "目前沒有人將他填為好朋友", "bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100")}
            </div>
            
            <div class="bg-white p-5 rounded-xl border border-orange-100 shadow-sm relative overflow-hidden">
              <div class="absolute top-0 left-0 w-1 h-full bg-rose-400"></div>
              <h3 class="flex items-center text-sm font-bold text-stone-700 border-b border-stone-100 pb-2 mb-3">
                <i class="fa-solid fa-user-minus mr-2 text-rose-500"></i>誰不想跟 ${student.name} 同組？ (${student.enemiesList.length})
              </h3>
              ${renderList(student.enemiesList, "目前沒有人不喜歡他", "bg-rose-50 text-rose-700 border border-rose-200 hover:bg-rose-100")}
            </div>
            
            <div class="bg-white p-5 rounded-xl border border-orange-100 shadow-sm relative overflow-hidden">
              <div class="absolute top-0 left-0 w-1 h-full bg-stone-300"></div>
              <h3 class="flex items-center text-sm font-bold text-stone-700 border-b border-stone-100 pb-2 mb-2">
                <i class="fa-solid fa-users-slash mr-2 text-stone-400"></i>系統無往來名單 (${student.noContactList.length})
              </h3>
              <p class="text-xs text-stone-400 mb-3 font-medium">雙方都沒有在問卷中提及彼此</p>
              ${renderList(student.noContactList, "他與班上每個人都有互動", "bg-stone-50 text-stone-600 border border-stone-200 hover:bg-stone-100")}
            </div>
          </div>
        </div>
      `;
    }

    // 啟動應用
    window.onload = init;

  </script>
</body>
</html>
